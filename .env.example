NPM_TOKEN="$TOKEN"
VITE_ENVIRONMENT="Production"
# Set to "true" to silence Vue runtime warnings in the terminal
VITE_HIDE_VUE_WARNINGS="false"
# Selects the SOAP API environment: "Development" (MAGDA test/aip) or "Production" (MAGDA prod)
NUXT_ENVIRONMENT="Production"

MAGDA_IDENTIFICATIE=""
VITE_DATASET_CONFIG_URL=https://raw.githubusercontent.com/Informatievlaanderen/data.vlaanderen.be2/refs/heads/dev/config/dataset.json
VITE_LICENSE_TTL_URL="https://raw.githubusercontent.com/Informatievlaanderen/codelijsten/master/licentie/licenties.ttl"
VITE_ORGANIZATION_TTL_URL=""
VITE_KBO_TTL_URL=""
NUXT_DEPARTMENT=""

# MAGDA SOAP client certificates (secrets — never commit)
# Directory containing the MAGDA client certificates (MAGDA-VKBO-subjectpages[-aip].pem, OVO002949-subjectpagesvkbo[-aip].crt, VOICA42026.crt)
# Locally this is ./certs. In production, point this at a mounted volume/secret
# (e.g. /app/certs) since the certs are not baked into the Docker image.
CERT_DIR=./certs
